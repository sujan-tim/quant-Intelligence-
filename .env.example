QIP_DATABASE_URL=postgresql+psycopg://qip:qip@localhost:5432/qip
QIP_DEMO_PROVIDER_ENABLED=true
QIP_RSI_WEIGHT=1.0
QIP_MACD_WEIGHT=1.0
QIP_SMA_WEIGHT=1.0
QIP_VOLUME_WEIGHT=1.0
QIP_VOLUME_SPIKE_THRESHOLD=2.0
# Optional. Obtain your own key from Alpha Vantage; the default is end-of-day historical data.
QIP_ALPHA_VANTAGE_API_KEY=
QIP_MARKET_DATA_ENTITLEMENT=historical

